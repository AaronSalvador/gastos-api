# Copia este archivo como application-local.yml y completa tus valores.
# application-local.yml está en .gitignore y no se sube a GitHub.
spring:
  datasource:
    password: TU_CONTRASEÑA_DE_POSTGRES

app:
  jwt:
    # Genera una con (PowerShell):
    # $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
    secret: PEGA_AQUI_TU_CLAVE_EN_BASE64
  assistant:
    # Opcional: clave de Anthropic para activar el asistente con IA (sin ella funciona en modo básico).
    api-key: ""

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true
